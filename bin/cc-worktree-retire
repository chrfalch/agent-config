#!/bin/bash
# Archives a worktree's task ledger, removes the worktree, then deletes its cc-dd-path build folders.
# --delete-branch <sha> then deletes the worktree's local branch, but only while it still points at
# <sha>. The caller decides whether that commit is merged: a squash-merged branch never looks merged
# to git. A branch that moved since is kept, and retiring still succeeds.
# A parent ledger with children not yet retired needs --force. A retired child is marked retired in
# its parent's ## Children section (see cc-ledger-parent).
# Usage: cc-worktree-retire <worktree-path> [--delete-branch <sha>] [git worktree remove flags]
set -eu

usage() {
  echo "usage: cc-worktree-retire <worktree-path> [--delete-branch <sha>] [--force]" >&2
  exit 1
}

arg="${1:-}"
[ -n "$arg" ] || usage
shift

self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done

delete_sha=""
force=""
remove_flags=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--delete-branch" ]; then
    delete_sha="${2:-}"
    [[ "$delete_sha" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || usage
    shift 2
  else
    case "$1" in --force|-f) force=1 ;; esac
    remove_flags+=("$1")
    shift
  fi
done

# Same match as slug() in hooks/ledger-list.sh.
title_slug() {
  sed -n -E '/^# Task ledger[[:space:]]*(—|-)[[:space:]]*/{s///;s/[[:space:]]+$//;p;q;}' "$1"
}

section() {
  awk -v heading="## $2" '/^## / { title = $0; sub(/[ \t\r]+$/, "", title); inside = title == heading; next } inside' "$1"
}

# The format cc-ledger-parent writes: `- <slug>`, or `- <slug> (retired YYYY-MM-DD)`.
active_children() {
  section "$1" Children | sed -n -E '/^- [A-Za-z0-9._-]+ \(retired [0-9]{4}-[0-9]{2}-[0-9]{2}\)[[:space:]]*$/d; s/^- ([A-Za-z0-9._-]+)[[:space:]]*$/\1/p'
}

wt=$(cd "$arg" 2>/dev/null; pwd)
if [ -z "$wt" ]; then
  echo "not a directory: $arg" >&2
  exit 1
fi

common=$(cd "$wt" 2>/dev/null; cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null; pwd)
if [ -z "$common" ]; then
  echo "not a git worktree: $wt" >&2
  exit 1
fi

main=$(dirname "$common")
repo=$(basename "$main")
branch=$(git -C "$wt" branch --show-current)
slug="${branch##*/}"
if [ -z "$slug" ]; then
  slug=$(basename "$wt")
fi

ledger="$wt/.claude/ledger.md"
task="" parent="" parent_ledger=""
if [ -f "$ledger" ]; then
  task=$(title_slug "$ledger")
  active=$(active_children "$ledger" | paste -sd, - | sed 's/,/, /g')
  if [ -n "$active" ] && [ -z "$force" ]; then
    echo "${task:-$slug} has active children: $active. Retire them first, or pass --force." >&2
    exit 1
  fi
  parent=$(section "$ledger" Location | sed -n -E '/^- parent:[[:space:]]*</d; s/^- parent:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1/p' | head -n 1)
fi
if [ -n "$parent" ]; then
  while IFS= read -r line; do
    candidate="${line#worktree }/.claude/ledger.md"
    if [ "$line" != "${line#worktree }" ] && [ -f "$candidate" ] && [ "$(title_slug "$candidate")" = "$parent" ]; then
      parent_ledger="$candidate"
      break
    fi
  done < <(git -C "$main" worktree list --porcelain)
fi

dest=""
if [ -f "$ledger" ]; then
  archive="$HOME/.claude/ledger-archive/$repo"
  mkdir -p "$archive"
  for old in "$archive"/*.md; do
    if [ -f "$old" ] && cmp -s "$ledger" "$old"; then
      dest="$old"
      echo "already archived $dest"
      break
    fi
  done
  if [ -z "$dest" ]; then
    dest="$archive/$(date +%F)-$slug.md"
    n=2
    while [ -e "$dest" ]; do
      dest="$archive/$(date +%F)-$slug-$n.md"
      n=$((n + 1))
    done
    cp "$ledger" "$dest"
    if ! cmp -s "$ledger" "$dest"; then
      echo "copy does not match the ledger: $dest" >&2
      exit 1
    fi
    echo "archived $dest"
  fi
else
  echo "no ledger at $ledger, nothing to archive"
fi

# Same formula as cc-dd-path; computed now because the worktree is gone after removal.
root=$(git -C "$wt" rev-parse --show-toplevel)
hash=$(printf '%s' "$root" | shasum | cut -c1-6)
prefix="$HOME/Library/Developer/Xcode/DerivedData/cc-$(basename "$root")-$hash-"

git -C "$main" worktree remove ${remove_flags[@]+"${remove_flags[@]}"} "$wt"
echo "removed  $wt"

# After the removal, so a refused removal leaves the parent's Children section as it was. Best
# effort: the worktree is gone, so a rerun could not finish what an exit here would skip.
marked=""
if [ -n "$parent_ledger" ]; then
  today=$(date +%F)
  if { TASK_CHILD="$task" TASK_TODAY="$today" awk '
    /^## / { title = $0; sub(/[ \t\r]+$/, "", title); inside = title == "## Children" }
    inside {
      line = $0
      cr = sub(/\r$/, "", line) ? "\r" : ""
      sub(/[ \t]+$/, "", line)
      if (line == "- " ENVIRON["TASK_CHILD"]) $0 = line " (retired " ENVIRON["TASK_TODAY"] ")" cr
    }
    { print }
  ' "$parent_ledger" > "$parent_ledger.tmp-$$" && mv "$parent_ledger.tmp-$$" "$parent_ledger"; } 2>/dev/null; then
    marked=1
  else
    rm -f "$parent_ledger.tmp-$$"
    echo "warning: could not update $parent_ledger; under ## Children, change '- $task' to '- $task (retired $today)' by hand" >&2
  fi
elif [ -n "$parent" ]; then
  echo "warning: no ledger for parent $parent in this repository, so its Children section is not updated" >&2
fi

if [ -n "$dest" ]; then
  "$(dirname "$self")/cc-ledgers" archive "$ledger" "$dest" || echo "warning: registry not updated" >&2
fi

for build in "$prefix"*; do
  if [ -d "$build" ]; then
    rm -rf "$build"
    echo "deleted  $build"
  fi
done

if [ -n "$delete_sha" ]; then
  if [ -z "$branch" ]; then
    echo "no branch to delete: HEAD was detached"
  elif error=$(git -C "$main" update-ref -d "refs/heads/$branch" "$delete_sha" 2>&1); then
    # update-ref leaves the branch's config section behind, which `git branch -D` would remove.
    git -C "$main" config --remove-section "branch.$branch" 2>/dev/null || true
    echo "deleted  branch $branch"
  elif [ "$(git -C "$main" rev-parse --verify --quiet "refs/heads/$branch")" != "$delete_sha" ]; then
    echo "kept     branch $branch, because it moved after retire checked it"
  else
    echo "kept     branch $branch, because git could not delete it: $error"
  fi
fi

if [ -n "$marked" ] && [ -z "$(active_children "$parent_ledger")" ]; then
  echo "Parent $parent has no active children left. Retire it with /ledger:retire $parent --yes."
fi
