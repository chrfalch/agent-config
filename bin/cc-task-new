#!/bin/bash
# Starts a separate task. A new task is a backlog task: a ledger filled from
# ledger.template.md at ~/.claude/ledger-backlog/<repo>/<slug>.md, with no branch or
# worktree yet. Its Location section records the main checkout, and the --branch and
# --base given, for the promotion.
# --refs <list> links comma-separated LLP numbers validated in the repo's llp/ folder.
# --promote turns a backlog task into a worktree task: a new branch, its worktree
# under the main checkout's .claude/worktrees/, and the ledger moved into it. It exits
# 2 when there is no such backlog task, 3 when the task belongs to another main
# checkout with the same folder name, and 4 when its ledger names no main checkout.
# --stack makes the worktree task at once, on top of the current branch.
# --repo <path> acts as if run in the repository that holds <path>, its main checkout or any
# worktree. It takes no --here or --stack, which build on the current worktree.
# Usage: cc-task-new <slug> [--goal <text>] [--branch <name>] [--base <ref> | --stack] [--repo <path>] [--refs <list>]
#        cc-task-new [--repo <path>] --promote <slug>
#        cc-task-new --here [<slug>] [--goal <text>] [--refs <list>]
# Works from the main checkout or from inside any linked worktree. Every check runs
# before the worktree is created, and a later failure removes the worktree and
# branch again, so a failure leaves nothing behind.
# --here creates no branch or worktree: it adds a ledger to the linked worktree it
# runs in. The slug defaults to the branch name without its owner prefix, the way
# cc-worktree-retire names the archive.
set -eu

usage="usage: cc-task-new <slug> [--goal <text>] [--branch <name>] [--base <ref> | --stack] [--repo <path>] [--refs <list>]
       cc-task-new [--repo <path>] --promote <slug>
       cc-task-new --here [<slug>] [--goal <text>] [--refs <list>]"

fail() {
  echo "$1" >&2
  exit 1
}

is_slug() (
  LC_ALL=C
  [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]
)

slug="" goal="" branch="" base="" stack="" here="" promote="" repo="" refs="" refs_given="" design_refs=""
while [ $# -gt 0 ]; do
  case "$1" in
    --goal|--branch|--base|--repo|--refs)
      [ $# -ge 2 ] || fail "$1 needs a value"
      case "$1" in
        --goal) goal="$2" ;;
        --branch) branch="$2" ;;
        --base) base="$2" ;;
        --repo) repo="$2" ;;
        --refs) refs="$2"; refs_given=1 ;;
      esac
      shift 2
      ;;
    --stack) stack=1; shift ;;
    --here) here=1; shift ;;
    --promote) promote=1; shift ;;
    -*) fail "unknown flag: $1"$'\n'"$usage" ;;
    *)
      [ -z "$slug" ] || fail "one slug only, got '$slug' and '$1'"$'\n'"$usage"
      slug="$1"
      shift
      ;;
  esac
done

[ -z "$promote" ] || [ -z "$goal$branch$base$stack$here$refs_given" ] ||
  fail "--promote takes only a slug: the backlog ledger holds the goal, branch, base and design refs"$'\n'"$usage"
[ -n "$slug" ] || [ -n "$here" ] || fail "$usage"
[ -z "$slug" ] || is_slug "$slug" || fail "slug must match ^[a-z0-9][a-z0-9-]*\$: $slug"
[ -z "$base" ] || [ -z "$stack" ] || fail "use --base or --stack, not both"
[ -z "$here" ] || [ -z "$base$stack$branch" ] || fail "--here keeps this worktree's branch and HEAD, so it takes no --base, --stack or --branch"
[ -z "$repo" ] || [ -z "$here$stack" ] || fail "--here and --stack build on this worktree, so they take no --repo"

self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
template="$(cd -P "$(dirname "$self")/.." && pwd)/ledger.template.md"
[ -f "$template" ] || fail "no ledger template at $template"

if [ -n "$repo" ]; then
  # Made absolute first, because register_ledger runs cc-ledgers from this script's folder.
  self="$(cd -P "$(dirname "$self")" && pwd)/$(basename "$self")"
  cd "$repo" 2>/dev/null || fail "no such folder: $repo"
fi

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || fail "not inside a git repository: $(pwd)"
main=$(dirname "$common")
backlog="$HOME/.claude/ledger-backlog/$(basename "$main")/$slug.md"
wt="" short=""

validate_refs() {
  local root="$1" number matches file
  if [ ! -d "$root/llp" ]; then
    [ -z "$refs_given" ] || fail "no llp/ folder in $root"
    return
  fi
  design_refs="none"
  [ -n "$refs_given" ] || return 0
  local remaining="$refs" seen=","
  design_refs=""
  while :; do
    number="${remaining%%,*}"
    number="${number#"${number%%[![:space:]]*}"}"
    number="${number%"${number##*[![:space:]]}"}"
    [ -n "$number" ] || fail "LLP refs item is empty"
    [[ $number =~ ^[0-9]{4}(\.[0-9]{3})*$ ]] || fail "unknown LLP number: $number"
    matches=0
    for file in "$root/llp/$number-"*.md; do
      [ ! -f "$file" ] || matches=$((matches + 1))
    done
    [ "$matches" -eq 1 ] || fail "unknown or ambiguous LLP number: $number (expected exactly one file)"
    case "$seen" in
      *,$number,*) ;;
      *)
        design_refs="${design_refs:+$design_refs, }LLP $number"
        seen="$seen$number,"
        ;;
    esac
    case "$remaining" in
      *,*) remaining="${remaining#*,}" ;;
      *) break ;;
    esac
  done
}

# Values travel through ENVIRON: awk -v and sed would rewrite backslashes and &.
# An empty value keeps the line of the source as it is. The main line is dropped,
# and written again only when $2 names the main checkout. Lines are joined by hand
# because print would add a final newline that a hand-edited source may lack.
write_ledger() {
  TASK_FINAL_NEWLINE=$([ -n "$(tail -c 1 "$1")" ] || echo 1) \
  TASK_DESIGN_REFS="$design_refs" TASK_PROMOTE="$promote" \
  TASK_SLUG="$slug" TASK_GOAL="$goal" TASK_MAIN="${2-}" TASK_WORKTREE="$wt" TASK_BRANCH="$branch" TASK_BASE="$base${short:+ @ $short}" \
    awk '
      function emit(line) { printf "%s%s", separator, line; separator = "\n" }
      /^## / { section = $0 }
      NR == 1 && /^# Task ledger — <slug>$/ { $0 = "# Task ledger — " ENVIRON["TASK_SLUG"] }
      section == "## Goal" && /^<.*>$/ && ENVIRON["TASK_GOAL"] != "" { $0 = ENVIRON["TASK_GOAL"] }
      section == "## Location" && /^- main: / { next }
      section == "## Location" && /^- worktree: / && ENVIRON["TASK_WORKTREE"] != "" { $0 = "- worktree: " ENVIRON["TASK_WORKTREE"] }
      section == "## Location" && /^- branch: / && ENVIRON["TASK_BRANCH"] != "" { $0 = "- branch: " ENVIRON["TASK_BRANCH"] }
      section == "## Location" && /^- base: / && ENVIRON["TASK_BASE"] != "" { $0 = "- base: " ENVIRON["TASK_BASE"] }
      section == "## Location" && /^- design refs: / && ENVIRON["TASK_PROMOTE"] == "" {
        if (ENVIRON["TASK_DESIGN_REFS"] == "") next
        $0 = "- design refs: " ENVIRON["TASK_DESIGN_REFS"]
      }
      { emit($0) }
      $0 == "## Location" && ENVIRON["TASK_MAIN"] != "" { emit("- main: " ENVIRON["TASK_MAIN"]) }
      END { if (ENVIRON["TASK_FINAL_NEWLINE"] != "") printf "\n" }
    ' "$1" > "$ledger"
}

# Prints nothing for a missing field or a template placeholder.
location_field() {
  awk -v key="- $1: " '
    /^## / { section = $0 }
    section == "## Location" && index($0, key) == 1 {
      value = substr($0, length(key) + 1)
      if (value !~ /^<.*>$/) print value
      exit
    }
  ' "$2"
}

register_ledger() {
  "$(dirname "$self")/cc-ledgers" upsert "$ledger" --repo "$(basename "$main")" --slug "$slug" --branch "$branch" "$@" ||
    echo "warning: registry not updated" >&2
}

# info/exclude is shared by every worktree of the repository, and is never committed.
exclude_evidence() {
  local exclude="$common/info/exclude"
  if grep -qxF '.claude/evidence/' "$exclude" 2>/dev/null; then return 0; fi
  { mkdir -p "$common/info" &&
    { [ ! -s "$exclude" ] || [ -z "$(tail -c 1 "$exclude")" ] || echo >> "$exclude"; } &&
    echo '.claude/evidence/' >> "$exclude"; } ||
    echo "warning: .claude/evidence/ not added to $exclude" >&2
}

report() {
  echo "worktree $wt"
  echo "branch   $branch"
  echo "base     $base @ $short"
  echo "ledger   $ledger"
  [ -n "$promote" ] || echo "start:   /ledger:go $slug"
}

check_target() {
  git -C "$main" check-ref-format --branch "$1" >/dev/null 2>&1 || fail "not a valid branch name: $1"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$1"; then fail "branch already exists: $1"; fi
  target="$main/.claude/worktrees/$slug"
  [ ! -e "$target" ] || fail "folder already exists: $target"
}

if [ -n "$here" ]; then
  [ "$(git rev-parse --path-format=absolute --git-dir)" != "$common" ] ||
    fail "--here needs a linked worktree, and $(pwd) is in the main checkout: a ledger lives only in a linked worktree"
  wt=$(git rev-parse --show-toplevel)
  ledger="$wt/.claude/ledger.md"
  [ ! -e "$ledger" ] || fail "this worktree already has a ledger: $ledger"
  branch=$(git branch --show-current)
  if [ -z "$slug" ]; then
    slug="${branch##*/}"
    [ -n "$slug" ] || slug=$(basename "$wt")
    is_slug "$slug" || fail "the slug from this worktree's branch must match ^[a-z0-9][a-z0-9-]*\$: $slug; pass one: cc-task-new --here <slug>"
  fi
  branch="${branch:-detached HEAD}"
  base="HEAD"
  short=$(git rev-parse --short HEAD) || fail "this worktree has no commit yet: $wt"
  validate_refs "$wt"
  mkdir -p "$wt/.claude"
  write_ledger "$template"
  register_ledger
  exclude_evidence
  report
  exit 0
fi

if [ -n "$stack" ]; then
  validate_refs "$(git rev-parse --show-toplevel)"
elif [ -z "$promote$here" ]; then
  validate_refs "$main"
fi

if [ -z "$stack$promote" ]; then
  [ ! -e "$backlog" ] || fail "backlog task already exists: $backlog"
  check_target "${branch:-$slug}"
  [ -z "$base" ] || git -C "$main" rev-parse --quiet --verify "$base^{commit}" >/dev/null || fail "unknown --base ref: $base"
  ledger="$backlog"
  mkdir -p "$(dirname "$ledger")"
  write_ledger "$template" "$main"
  register_ledger
  echo "ledger:  $ledger"
  echo "status:  backlog"
  echo "start:   /ledger:go $slug"
  exit 0
fi

source="$template"
if [ -n "$promote" ]; then
  if [ ! -f "$backlog" ]; then
    echo "no backlog task $slug" >&2
    exit 2
  fi
  owner=$(location_field main "$backlog")
  if [ -z "$owner" ]; then
    echo "backlog ledger $backlog has no main line" >&2
    exit 4
  fi
  if [ "$owner" != "$main" ]; then
    echo "backlog task $slug belongs to $owner; run /ledger:go $slug from a session in that repository" >&2
    exit 3
  fi
  branch=$(location_field branch "$backlog")
  base=$(location_field base "$backlog")
  source="$backlog"
fi

branch="${branch:-$slug}"

if [ -n "$stack" ]; then
  base=$(git branch --show-current)
  [ -n "$base" ] || fail "--stack needs a branch, but HEAD is detached in $(pwd)"
elif [ -z "$base" ]; then
  base=$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD) ||
    base=$(git -C "$main" branch --show-current)
  [ -n "$base" ] || fail "no origin/HEAD and $main is on a detached HEAD; pass --base <ref>"
fi
sha=$(git -C "$main" rev-parse --quiet --verify "$base^{commit}") || fail "unknown --base ref: $base"
short=$(git -C "$main" rev-parse --short "$sha")

check_target "$branch"

# A commit, not the ref, so a branch made from origin/main does not track it.
git -C "$main" worktree add --quiet -b "$branch" "$target" "$sha"
trap 'git -C "$main" worktree remove --force "$target" || true; git -C "$main" branch --quiet -D "$branch"' EXIT
wt=$(cd "$target" && pwd)
ledger="$wt/.claude/ledger.md"
mkdir -p "$wt/.claude"

write_ledger "$source"
if [ -n "$promote" ]; then
  rm "$backlog"
  register_ledger --replaces "$backlog"
else
  register_ledger
fi
trap - EXIT
exclude_evidence
report
