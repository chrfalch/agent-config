{
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd // \"\"'); dir=\"${dir/#$HOME/~}\"; model=$(echo \"$input\" | jq -r '.model.display_name // \"\"'); sess=$(echo \"$input\" | jq -r '.rate_limits.five_hour.used_percentage // empty'); week=$(echo \"$input\" | jq -r '.rate_limits.seven_day.used_percentage // empty'); sess_seg=\"\"; [ -n \"$sess\" ] && sess_seg=\" | session:$(printf '%.0f' \"$sess\")%\"; week_seg=\"\"; [ -n \"$week\" ] && week_seg=\" week:$(printf '%.0f' \"$week\")%\"; branch=\"\"; if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then branch=$(git branch --show-current 2>/dev/null); fi; branch_seg=\"\"; [ -n \"$branch\" ] && branch_seg=\" \\033[0;32m${branch}\\033[0m\"; printf '%b' \"\\033[0;34m${dir}\\033[0m${branch_seg} [\\033[0;36m${model}\\033[0m${sess_seg}${week_seg}]\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/derived-data-gate.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/worktree-gate.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ledger-gate.sh"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash|Read|Grep|Glob|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/denied-read-retry.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ledger-list.sh pre-compact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/deploy-drift.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ledger-list.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ledger-list.sh prompt-submit"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
