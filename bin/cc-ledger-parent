#!/usr/bin/env node
// Makes one task the parent of another in the same repository, and shows a parent's children.
// Usage: cc-ledger-parent add <parent> <child>
//        cc-ledger-parent remove <parent> <child>
//        cc-ledger-parent show <parent> [--json]
//        cc-ledger-parent start <parent> <child>
//        cc-ledger-parent next <parent>
// A slug is a ledger's title slug, looked up in the ledgers of every worktree of the repository
// that holds the current folder, and in the backlog ledgers that name its main checkout. The
// child's `- parent: <slug>` bullet under ## Location is the source of truth. The parent's
// ## Children section lists its children, so that a retired child, whose ledger is gone, keeps a
// line there: `- <slug> (retired YYYY-MM-DD)`. /ledger:go marks a child it starts with
// `- <slug> (started YYYY-MM-DD)` (start), and starts the child that next prints.
'use strict';
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const usage = [
  'usage: cc-ledger-parent add <parent> <child>',
  '       cc-ledger-parent remove <parent> <child>',
  '       cc-ledger-parent show <parent> [--json]',
  '       cc-ledger-parent start <parent> <child>',
  '       cc-ledger-parent next <parent>',
].join('\n');

const backlogRoot = path.join(os.homedir(), '.claude', 'ledger-backlog');
const inBacklog = (ledger) => path.dirname(path.dirname(ledger)) === backlogRoot;

const SLUG = /^[A-Za-z0-9._-]+$/;
const CHILD = /^- ([A-Za-z0-9._-]+)(?: \((retired|started) (\d{4}-\d\d-\d\d)\))?$/;
// Same marker as parkedOf() in mods/ledger/hooks/ledger.ts.
const PARKED = /^Parked:[ \t]*\d{4}-\d{2}-\d{2}[ \t]*[—-]/;

function fail(message) {
  console.error(message);
  process.exit(1);
}

// Same match as titleSlug() in cc-ledgers.
function titleSlug(text) {
  return text.match(/^# Task ledger[ \t]*(?:—|-)[ \t]*(.*)$/m)?.[1].trim() ?? '';
}

function git(...args) {
  const result = spawnSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
  if (result.status !== 0) fail(`not inside a git repository: ${process.cwd()}`);
  return result.stdout;
}

// The main checkout the way cc-task-new works it out, so it matches the `- main:` line cc-task-new writes.
function mainCheckout() {
  return path.dirname(git('rev-parse', '--path-format=absolute', '--git-common-dir').trim());
}

// Another repository with the same folder name shares the backlog folder; its ledgers name another main checkout.
function backlogLedgers(main) {
  const folder = path.join(backlogRoot, path.basename(main));
  let names;
  try {
    names = fs.readdirSync(folder);
  } catch (error) {
    if (error.code === 'ENOENT') return [];
    throw error;
  }
  return names
    .filter((name) => name.endsWith('.md'))
    .map((name) => path.join(folder, name))
    .filter((ledger) => {
      const lines = fs.readFileSync(ledger, 'utf8').split('\n');
      return body(lines, 'Location').some((line) => line.trimEnd().match(/^- main:[ \t]*(.*)$/)?.[1] === main);
    });
}

function ledgersBySlug() {
  const worktrees = git('worktree', 'list', '--porcelain')
    .split('\n')
    .filter((line) => line.startsWith('worktree '))
    .map((line) => path.join(line.slice('worktree '.length), '.claude', 'ledger.md'))
    .filter((ledger) => fs.statSync(ledger, { throwIfNoEntry: false })?.isFile());
  const found = new Map();
  for (const ledger of [...worktrees, ...backlogLedgers(mainCheckout())]) {
    const slug = titleSlug(fs.readFileSync(ledger, 'utf8'));
    if (slug) found.set(slug, [...(found.get(slug) ?? []), ledger]);
  }
  return found;
}

function lookup(found, slug) {
  const files = found.get(slug) ?? [];
  if (files.length > 1) fail(`${files.length} ledgers in this repository have the slug ${slug}: ${files.join(', ')}`);
  if (files.length === 0) return undefined;
  const text = fs.readFileSync(files[0], 'utf8');
  // Lines keep their own `\r`, so a save changes only the lines it adds or drops.
  return { slug, file: files[0], lines: text.split('\n'), cr: text.includes('\r\n') ? '\r' : '' };
}

function resolve(found, slug) {
  return lookup(found, slug) ?? fail(`no task ledger with the slug ${slug} in this repository`);
}

function insert(task, index, ...lines) {
  task.lines.splice(index, 0, ...lines.map((line) => line + task.cr));
}

// The heading's line index, and the index of the next heading or the end of the file.
function section(lines, heading) {
  const start = lines.findIndex((line) => line.trimEnd() === `## ${heading}`);
  if (start === -1) return undefined;
  const next = lines.findIndex((line, index) => index > start && line.startsWith('## '));
  return { start, end: next === -1 ? lines.length : next };
}

function body(lines, heading) {
  const found = section(lines, heading);
  return found ? lines.slice(found.start + 1, found.end) : [];
}

function afterLastText(lines, { start, end }) {
  let index = end;
  while (index > start + 1 && lines[index - 1].trim() === '') index--;
  return index;
}

const firstText = (lines) => lines.map((line) => line.trim()).find((line) => line !== '') ?? '';

function parentBullet(lines) {
  const found = section(lines, 'Location');
  if (!found) return undefined;
  for (let index = found.start + 1; index < found.end; index++) {
    // One word, and not a template placeholder, the same as the parent cc-worktree-retire reads.
    const value = lines[index].trimEnd().match(/^- parent:[ \t]*(\S+)$/)?.[1];
    if (value !== undefined && !value.startsWith('<')) return { index, value };
  }
  return undefined;
}

function children(lines) {
  const found = section(lines, 'Children');
  if (!found) return [];
  const listed = [];
  for (let index = found.start + 1; index < found.end; index++) {
    const [, slug, mark, date] = lines[index].trim().match(CHILD) ?? [];
    if (slug) listed.push({ index, slug, ...(mark && { [mark]: date }) });
  }
  return listed;
}

function location(task) {
  return section(task.lines, 'Location') ?? fail(`${task.file} has no ## Location section`);
}

// A temporary file and a rename, so a failed write leaves the ledger as it was.
function save(task) {
  const temporary = `${task.file}.tmp-${process.pid}`;
  try {
    fs.writeFileSync(temporary, task.lines.join('\n'), { mode: fs.statSync(task.file).mode });
    fs.renameSync(temporary, task.file);
  } catch (error) {
    fs.rmSync(temporary, { force: true });
    throw error;
  }
}

// Best effort, as register_ledger in cc-task-new: the ledger is the record, the registry an index of it.
function register(ledger, ...flags) {
  const result = spawnSync(path.join(__dirname, 'cc-ledgers'), ['upsert', ledger, ...flags], { stdio: ['ignore', 'inherit', 'inherit'] });
  if (result.status !== 0) console.error('warning: registry not updated');
}

// The parent of `task`, its parent, and so on, up to a slug with no ledger or a slug seen before.
function ancestors(found, task) {
  const seen = [];
  let slug = parentBullet(task.lines)?.value;
  while (slug !== undefined && !seen.includes(slug)) {
    seen.push(slug);
    const ledger = lookup(found, slug);
    slug = ledger && parentBullet(ledger.lines)?.value;
  }
  return seen;
}

function add(parentSlug, childSlug) {
  if (parentSlug === childSlug) fail(`${childSlug} cannot be its own parent`);
  const found = ledgersBySlug();
  const parent = resolve(found, parentSlug);
  const child = resolve(found, childSlug);
  if (children(parent.lines).some(({ slug, retired }) => retired && slug === child.slug)) {
    fail(`${child.slug} is a retired child of ${parent.slug}; give the new task another slug`);
  }
  const current = parentBullet(child.lines)?.value;
  if (current !== undefined && current !== parent.slug) {
    fail(`${child.slug} already has the parent ${current}; first run cc-ledger-parent remove ${current} ${child.slug}`);
  }
  if (ancestors(found, parent).includes(child.slug)) {
    fail(`${child.slug} is already the parent of ${parent.slug} or of one of its parents, so making it a child of ${parent.slug} would make a cycle`);
  }
  const childLocation = location(child);
  const parentLocation = location(parent);

  // The child's bullet first: once it is written, a rerun of the same add finishes the parent.
  if (current === undefined) {
    insert(child, afterLastText(child.lines, childLocation), `- parent: ${parent.slug}`);
    save(child);
  }
  if (!children(parent.lines).some(({ slug }) => slug === child.slug)) {
    const listed = section(parent.lines, 'Children');
    if (listed) insert(parent, afterLastText(parent.lines, listed), `- ${child.slug}`);
    else insert(parent, afterLastText(parent.lines, parentLocation), '', '## Children', `- ${child.slug}`);
    save(parent);
  }
  register(child.file, '--parent', parent.slug);
}

function remove(parentSlug, childSlug) {
  const found = ledgersBySlug();
  const parent = resolve(found, parentSlug);
  const child = resolve(found, childSlug);
  const bullet = parentBullet(child.lines);
  if (bullet?.value !== parent.slug) fail(`${child.slug} is not a child of ${parent.slug}`);

  // The parent first: until the child's bullet is gone, a rerun of the same remove still finds the pair.
  const lines = children(parent.lines).filter(({ slug }) => slug === child.slug);
  if (lines.length > 0) {
    for (const { index } of lines.reverse()) parent.lines.splice(index, 1);
    const listed = section(parent.lines, 'Children');
    if (firstText(body(parent.lines, 'Children')) === '') parent.lines.splice(listed.start, listed.end - listed.start);
    save(parent);
  }
  child.lines.splice(bullet.index, 1);
  save(child);
  register(child.file);
}

function childStatus(found, { slug, retired }) {
  if (retired) return { slug, status: 'retired', next: '' };
  const child = lookup(found, slug);
  if (!child) return { slug, status: 'missing', next: '' };
  const next = body(child.lines, 'Next step');
  return {
    slug,
    status: inBacklog(child.file) ? 'backlog' : PARKED.test(firstText(next)) ? 'parked' : 'active',
    next: firstText(next.filter((line) => !PARKED.test(line.trim()))),
  };
}

// A retired slug can belong to a new task, so its ledger is not the child's.
function childTime(found, { slug, retired }) {
  if (retired) {
    const [year, month, day] = retired.split('-').map(Number);
    return new Date(year, month - 1, day).getTime();
  }
  const file = found.get(slug)?.[0];
  return file ? fs.statSync(file).mtimeMs : 0;
}

// The order of childOrder() in mods/ledger/hooks/ledger.ts: active first, then the others, each newest first by the time
// of the child's ledger, or its retire date once retired. A child with neither counts as oldest, and the stable sort keeps
// their Children order.
function ordered(found, listed) {
  const dated = listed.map((child) => ({ shown: childStatus(found, child), time: childTime(found, child) }));
  const active = ({ shown }) => shown.status === 'active';
  return dated.sort((a, b) => Number(active(b)) - Number(active(a)) || b.time - a.time).map(({ shown }) => shown);
}

function show(parentSlug, json) {
  const found = ledgersBySlug();
  const parent = resolve(found, parentSlug);
  const shown = {
    parent: parent.slug,
    goal: firstText(body(parent.lines, 'Goal')),
    children: ordered(found, children(parent.lines)),
  };
  if (json) {
    console.log(JSON.stringify(shown, null, 2));
    return;
  }
  console.log([shown.parent, shown.goal].join('\t'));
  for (const { slug, status, next } of shown.children) console.log([slug, status, next].join('\t'));
}

// The local date, as `date +%F` in cc-worktree-retire writes it.
function today() {
  const now = new Date();
  return [now.getFullYear(), now.getMonth() + 1, now.getDate()].map((part) => String(part).padStart(2, '0')).join('-');
}

function start(parentSlug, childSlug) {
  const parent = resolve(ledgersBySlug(), parentSlug);
  const line = children(parent.lines).find(({ slug }) => slug === childSlug) ?? fail(`${childSlug} is not listed under ## Children of ${parent.slug}`);
  if (line.retired || line.started) return;
  const text = parent.lines[line.index];
  parent.lines[line.index] = `${text.match(/^\s*/)[0]}- ${childSlug} (started ${today()})${text.endsWith('\r') ? '\r' : ''}`;
  save(parent);
  console.log(`started ${childSlug} in ${parent.file}`);
}

// The slugs from `path`'s last task down to its first child, in Children order, that is neither marked nor out of the
// backlog. A child with children of its own is searched instead, and passed over when none of them is left to start, so
// that one finished branch does not hide its later siblings. A slug already on `path` is a cycle, and is skipped.
function firstToStart(found, task, path) {
  for (const { slug, retired, started } of children(task.lines)) {
    if (retired || started || path.includes(slug)) continue;
    const child = lookup(found, slug);
    if (!child || !inBacklog(child.file)) continue;
    const picked = children(child.lines).length === 0 ? [...path, slug] : firstToStart(found, child, [...path, slug]);
    if (picked) return picked;
  }
  return undefined;
}

function next(parentSlug) {
  const found = ledgersBySlug();
  const picked = firstToStart(found, resolve(found, parentSlug), [parentSlug]);
  if (picked) console.log(picked.join(' '));
}

const [command, ...args] = process.argv.slice(2);
const slugs = args.filter((arg) => arg !== '--json');
const json = slugs.length < args.length;

// The Children line format and cc-worktree-retire read a slug as one word of these characters.
function supported(...given) {
  for (const slug of given) if (!SLUG.test(slug)) fail(`unsupported slug ${JSON.stringify(slug)}: a slug must match ^[A-Za-z0-9._-]+$`);
  return given;
}

try {
  const changes = { add, remove, start };
  if (Object.hasOwn(changes, command) && args.length === 2 && !json) changes[command](...supported(...args));
  else if (command === 'show' && slugs.length === 1) show(...supported(slugs[0]), json);
  else if (command === 'next' && args.length === 1 && !json) next(...supported(args[0]));
  else fail(usage);
} catch (error) {
  fail(`cc-ledger-parent ${command}: ${error.message}`);
}
